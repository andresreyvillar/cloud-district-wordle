# Files excluded from Cloudflare Pages/Workers asset upload
# Syntax: gitignore-like patterns

# Secrets and environment
.env
.env.*
!.env.example

# Backend scripts and tooling
*.py
/tools/
extract_data.py
update.sh
update.log

# Legacy / source-only data.
#
# ANCLADO con barra inicial, y no es cosmético: `data/` sin anclar casa a CUALQUIER profundidad con la
# semántica de gitignore, así que se tragaba `v2/js/data/` entero — siete módulos— y la v2 se desplegaba
# rota, sirviendo el index como si fuera JavaScript. El deploy decía "Success" y la web no arrancaba.
/data/

# Método spec-driven: especificaciones, harness y documentación
/openspec/
/openspec.workspace.yaml
/docs/
/tests/
CLAUDE.md
.claude/

# Entorno y configuración de desarrollo
/.venv/
pytest.ini
requirements.txt
requirements-dev.txt
.pytest_cache/

# Snapshots de sesión (contexto de trabajo, no de producto)
context-snapshot-*.md

# La v2.0 se publica en /2/ del MISMO Worker (worker/index.js reescribe /2/… → /v2/…), así que sus ficheros
# sí se suben. Consecuencia declarada: quedan también accesibles en /v2/…, porque esas rutas encajan con un
# asset y el script no llega a verlas. Son los mismos ficheros públicos, no un agujero.
wrangler.v2.jsonc

# El script del Worker se empaqueta como código, no se sirve como fichero.
/worker/

# El directorio temporal de wrangler: el primer deploy subió su bundle como asset.
/.wrangler/

# Páginas de desarrollo de la v2 y su ignore, que solo aplica al config alternativo.
v2/dev/
v2/.assetsignore

# Repo metadata
.git/
.gitignore
.github/
README.md
wrangler.jsonc

# Editor / OS junk
.DS_Store
.vscode/
__pycache__/
*.tmp
